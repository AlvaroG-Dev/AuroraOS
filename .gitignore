# Build artifacts
*.o
*.elf
*.bin
*.img
*.iso
*.EFI
*.a

# Imagen de disco del ESP (se genera con make)
aurora/EFI.IMG
aurora/*.IMG
aurora/*.img

# Initramfs generado
kernel/initrd.tar
sysroot/

# QEMU
OVMF_VARS.fd
ovmf_vars.fd
qemu.log
serial.log
out.log

# Sistema
a.out
*.bak
*.swp
*~
*:Zone.Identifier
toolchain/*.tgz
toolchain/*.tar.gz
toolchain/*.tar.bz2
third_party/*.tar.bz2
third_party/*.tar.gz
*.tar.bz2
*.tar.gz
*.tgz

# IDE
.vscode/
.idea/
*.code-workspace

# kernel.bak.string (parece un backup tuyo)
kernel.bak.string/
kernel.bak
debug.log
qemu_debug.log

# Mesa/LLVM de Ubuntu: demasiado grande para git; se baja con scripts/fetch-mesa.sh
libs/glibc/lib/x86_64-linux-gnu/libLLVM*
libs/glibc/lib/x86_64-linux-gnu/libgallium*
precompiled/usr/lib/x86_64-linux-gnu/dri/
build/mesa_stage/

# LinuxKPI: fuentes externas (scripts/fetch-linux-drivers.sh) y objetos
build/linuxkpi_src/
build/linuxkpi/

# Tabla de particiones MBR que make iso recalcula en cada build (Makefile, ISO).
build/mbr_part.hex

# El firmware de prueba de request_firmware si se versiona (no es un artefacto).
!precompiled/lib/firmware/aurora/selftest.bin
scripts/__pycache__/

# Dependencias de cabeceras del kernel (-MMD)
*.d
kernel/.deps-stamp

# Artefactos generados (NVIDIA N1/N2)
/build/nvidia/
/build/nvidia-kpi/
/build/nvidia-smoke/
/build/drive-aurora.conf
/build/mbr_part2.hex
drivers/kur/nvprobe/nvprobe.kur
