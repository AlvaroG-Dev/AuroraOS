#!/bin/sh
# aurora-wine — lanza un programa Windows con Wine y el aspecto de Aurora.
#   aurora-wine programa.exe [args...]    (o un .msi, .lnk, .bat)
#   aurora-wine --setup                   (solo preparar el prefijo)
# Prefijo: $WINEPREFIX o ~/.wine. Un prefijo nuevo ya nace con la paleta de
# Aurora (wine.inf); aquí se sigue el modo claro/oscuro del sistema
# (/data/aurora-theme, el mismo que usan GTK y Qt) cada vez que se lanza.
: "${WINEPREFIX:=${HOME:-/root}/.wine}"
export WINEPREFIX
# Sin pantalla Wayland/X propia: la sesión de Aurora (aurora-wayland + Xwayland).
[ -n "$DISPLAY" ] || export DISPLAY=:0
[ -n "$XDG_RUNTIME_DIR" ] || export XDG_RUNTIME_DIR=/run/user/$(id -u 2>/dev/null || echo 0)
# Mono/Gecko no vienen en la ISO: que wineboot no pregunte por ellos.
case ",$WINEDLLOVERRIDES," in *mscoree*) ;; *) export WINEDLLOVERRIDES="mscoree,mshtml=${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}" ;; esac
# GPU. Al arrancar, win32u enumera los dispositivos EGL (EGL_EXT_device_
# enumeration) y los inicializa. Si /dev/dri/card0 no tiene driver 3D de Mesa
# (nvidia-drm, el DRM nativo de Aurora, bochs...), Mesa con
# LIBGL_ALWAYS_SOFTWARE=1 toma el camino swrast sin loader de swrast y cae en
# drisw_init_screen (puntero nulo); Wine se queda colgado. Con kms_swrast ese
# dispositivo se abre bien. Las GPUs con driver de Mesa no cambian, y la
# NVIDIA sigue sirviendo GLX/Vulkan por sus bibliotecas.
drv=$(sed -n 's/^DRIVER=//p' /sys/class/drm/card0/device/uevent 2>/dev/null)
case "$drv" in
    i915|xe|amdgpu|radeon|nouveau) ;;
    *) : "${MESA_LOADER_DRIVER_OVERRIDE:=kms_swrast}"; export MESA_LOADER_DRIVER_OVERRIDE ;;
esac
# GPU NVIDIA: con sus bibliotecas cargadas (GLX/EGL/Vulkan), los procesos de
# Wine se quedan esperando para siempre al crear el prefijo (PC con RTX 4060,
# 2026-11-20). Por omisión Wine va por software (Mesa) con una NVIDIA;
# AURORA_WINE_GPU=1 la usa. AURORA_WINE_GPU=0 fuerza software con cualquier GPU.
case "$drv" in nvidia*) gpu_def=0 ;; *) gpu_def=1 ;; esac
wine_sw() {
    export VK_LOADER_DRIVERS_DISABLE='*nvidia*'
    export __GLX_VENDOR_LIBRARY_NAME=mesa
    export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
    export LIBGL_ALWAYS_SOFTWARE=1
}
[ "${AURORA_WINE_GPU:-$gpu_def}" = 0 ] && wine_sw
# Registro: errores de Wine en /data/aurora-wine.log (si /data se puede escribir).
if [ -z "$AURORA_WINE_LOG" ]; then
    AURORA_WINE_LOG=/dev/null
    if [ -d /data ] && touch /data/aurora-wine.log 2>/dev/null; then
        AURORA_WINE_LOG=/data/aurora-wine.log
        : "${WINEDEBUG:=err+all,fixme-all}"
    fi
fi
: "${WINEDEBUG:=-all}"
export WINEDEBUG
log() { echo "[$(date '+%F %T')] aurora-wine: $*" >>"$AURORA_WINE_LOG"; }

SHARE=/usr/share/aurora/wine
mode=dark
[ "${AURORA_THEME:-$(cat /data/aurora-theme 2>/dev/null)}" = light ] && mode=light

log "$* (GPU ${AURORA_WINE_GPU:-$gpu_def}, card0=${drv:-?}, prefijo $WINEPREFIX)"
if [ ! -f "$WINEPREFIX/system.reg" ]; then
    # Crear el prefijo no necesita la GPU: siempre por software, y con tope de
    # tiempo para que un proceso colgado no deje a Wine parado para siempre.
    echo "aurora-wine: creando el prefijo de Wine en $WINEPREFIX (la primera vez tarda un poco)..." >&2
    log "creando el prefijo"
    wineserver -k 2>/dev/null
    ( wine_sw; timeout 600 wineboot -i ) >>"$AURORA_WINE_LOG" 2>&1
    rc=$?
    # 124/137: el tope de tiempo lo paro (system.reg puede tardar unos
    # segundos más en escribirse: no sirve para saber si fue bien).
    if [ $rc = 124 ] || [ $rc = 137 ]; then
        log "wineboot no termino (rc=$rc)"
        wineserver -k 2>/dev/null
        echo "aurora-wine: no se pudo crear el prefijo (rc=$rc); detalles en $AURORA_WINE_LOG" >&2
        exit 1
    fi
    log "prefijo creado"
fi
if [ "$(cat "$WINEPREFIX/.aurora-theme" 2>/dev/null)" != "$mode" ] && [ -f "$SHARE/aurora-$mode.reg" ]; then
    wine regedit /S "$SHARE/aurora-$mode.reg" >>"$AURORA_WINE_LOG" 2>&1 && echo "$mode" > "$WINEPREFIX/.aurora-theme"
fi
[ "$1" = "--setup" ] && exit 0
[ $# -eq 0 ] && set -- winecfg
case "$1" in
    *.msi|*.MSI) exec wine msiexec /i "$@" ;;
    *.lnk|*.LNK|*.bat|*.BAT|*.cmd|*.CMD) exec wine start /unix "$@" ;;
esac
exec wine "$@"
