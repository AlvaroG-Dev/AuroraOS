[Icon Theme]
Name=Aurora
Comment=Iconos de Aurora (estilo macOS); el resto hereda de Adwaita
Inherits=Adwaita,hicolor
Example=folder
Directories=scalable/places,scalable/apps,scalable/mimetypes

[scalable/places]
Context=Places
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[scalable/apps]
Context=Applications
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=64
MinSize=16
MaxSize=512
Type=Scalable
