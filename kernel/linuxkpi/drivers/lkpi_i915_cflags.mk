# Configuracion de i915 (Kconfig fuera del arbol): perfil por defecto de Kconfig.profile.
# DRM_I915_USERPTR, PXP, GVT, DP_TUNNEL y COMPRESS_ERROR desactivados (ver Plan_LinuxKPI.md §11, L7).
LKPI_I915_CFLAGS := -DCONFIG_DRM_I915=1 -DCONFIG_X86=1 -DCONFIG_ACPI=1 -DI915 \
    -DCONFIG_DRM_I915_REQUEST_TIMEOUT=20000 -DCONFIG_DRM_I915_FENCE_TIMEOUT=10000 \
    -DCONFIG_DRM_I915_USERFAULT_AUTOSUSPEND=250 -DCONFIG_DRM_I915_HEARTBEAT_INTERVAL=2500 \
    -DCONFIG_DRM_I915_PREEMPT_TIMEOUT=640 -DCONFIG_DRM_I915_PREEMPT_TIMEOUT_COMPUTE=7500 \
    -DCONFIG_DRM_I915_MAX_REQUEST_BUSYWAIT=8000 -DCONFIG_DRM_I915_STOP_TIMEOUT=100 \
    -DCONFIG_DRM_I915_TIMESLICE_DURATION=1 -DCONFIG_DRM_I915_CAPTURE_ERROR=1 \
    '-DCONFIG_DRM_I915_FORCE_PROBE=""' -include lkpi/gpu_prelude.h
